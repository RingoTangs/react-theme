{
  "name": "@ringotangs/react-theme",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "Lightweight React theme management with system theme detection, persistence, and SSR support.",
  "author": "RingoTangs",
  "license": "MIT",
  "homepage": "https://github.com/RingoTangs/react-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RingoTangs/react-theme.git"
  },
  "bugs": {
    "url": "https://github.com/RingoTangs/react-theme/issues"
  },
  "keywords": [
    "react",
    "react-theme",
    "theme",
    "theme-management",
    "dark-mode",
    "system-theme",
    "ssr",
    "persistence"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tsdown",
    "build": "cross-env NODE_ENV=production tsdown",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter @react-theme/react-spa build && pnpm --filter @react-theme/tanstack-start build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -b",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "pnpm check && pnpm build && pnpm pack:check"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.3.0",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@playwright/test": "^1.56.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@ringotangs/tsconfig": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "cross-env": "^10.1.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
